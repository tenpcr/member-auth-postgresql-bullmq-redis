NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://member_auth:local_dev_password@localhost:5432/member_auth?schema=public"

REDIS_URL=""

JWT_ACCESS_SECRET="your-access-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-refresh-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3001"

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="no-reply@yourdomain.com"

OBSERVE_APP_KEY="YOUR_APP_KEY"
OBSERVE_APP_SECRET="YOUR_APP_SECRET"